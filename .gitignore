# python
__pycache__/
*.py[cod]
*$py.class

# venv
.venv/
venv/
env/
ENV/

# config
.env
.env.*
!.env.example

# Chave local de autenticacao do EV3 (nunca versionar).
ev3/token.txt

# local data
data/*.db
data/*.db-*
data/system_config.local.json
data/mearm-flow-profile.local.json
# Arquivos de controle/gravacao atomica do cadastro JSON.
data/*.json.lock
data/.catalog-*.tmp
output/*.json.lock
output/.catalog-*.tmp

# Ferramentas e resultados locais da bancada (nao sao firmware para gravar).
output/arduino-toolchain/
output/arduino-build*/
output/firmware-compile-only/
output/firmware-tools/
output/firmware-native*/
output/firmware*-compile.log
output/test-tmp/
output/test-*.log
output/logs/
output/bancada*.db
output/bancada*.db-*
output/bancada*.json
output/antes-json-automatico-*.db

# OS
.vscode/
.idea/
# Scripts e logs avulsos de bancada (ex.: rede Bluetooth do EV3).
output/*.ps1
output/*.log
# Backups locais de checkpoint (contem token e banco; nunca versionar).
output/checkpoints/
